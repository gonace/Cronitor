<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs against the TickerQ major Cronitor.TickerQ is built for; pass -p:TickerQMajor=8 or 9 to test the others. -->
  <PropertyGroup>
    <TickerQMajor Condition="'$(TickerQMajor)' == ''">10</TickerQMajor>
    <TargetFramework>net$(TickerQMajor).0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.v3.runner.console" Version="4.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cronitor.TickerQ\Cronitor.TickerQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared.Tests\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Using Include="Cronitor.Shared.Tests" />
  </ItemGroup>

</Project>
