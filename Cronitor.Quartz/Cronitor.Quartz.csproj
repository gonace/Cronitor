<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The code that is the same for every Quartz major lives in this folder; the code that uses an API that differs
    between majors lives in a QuartzN folder, and only the folder of the major being built is compiled.
  -->
  <PropertyGroup>
    <QuartzMajor Condition="'$(QuartzMajor)' == ''">3</QuartzMajor>
  </PropertyGroup>

  <Target Name="ValidateQuartzMajor" BeforeTargets="Restore;CollectPackageReferences;Build">
    <Error Condition="'$(QuartzMajor)' != '3'" Text="QuartzMajor must be 3, not '$(QuartzMajor)'." />
  </Target>

  <ItemGroup>
    <Compile Remove="Quartz*\**" />
    <Compile Include="Quartz$(QuartzMajor)\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Cronitor.Quartz</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Cronitor.Quartz</PackageId>
    <!-- Major and minor follow the lowest Quartz version this package supports, see the Quartz references below. -->
    <Version Condition="'$(ReleaseRun)' != ''">3.22.$(ReleaseRun)</Version>
    <Description>Reports every Quartz.NET job to Cronitor: run when it starts, complete when it succeeds and fail when it throws.</Description>
    <PackageTags>cronitor;quartz;quartz.net;monitoring;cron;scheduler;jobs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cronitor.Quartz.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Quartz" Version="[3.22.4,4.0)" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="[3.22.4,4.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cronitor\Cronitor.csproj" />
  </ItemGroup>

</Project>
